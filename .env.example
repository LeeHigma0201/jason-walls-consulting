# Copy to .env.local for local runs; set the same names in Vercel (Production) for the live site.
# Nothing here is required for the site to build. Empty values hide the matching feature.

# Public contact address shown in the footer, contact page and schema. Empty = no address shown,
# the form is the only route. (hi@jasonwalls.work is NOT live: the domain is unregistered.)
NEXT_PUBLIC_CONTACT_EMAIL=

# Where contact-form messages are delivered. Defaults to GMAIL_USER, then NEXT_PUBLIC_CONTACT_EMAIL.
CONTACT_TO=

# Transport 1 (no new account): Gmail SMTP with a Google app password
# (Google Account > Security > 2-Step Verification > App passwords). Server-only, never NEXT_PUBLIC.
GMAIL_USER=
GMAIL_APP_PASSWORD=

# Transport 2 (alternative): Resend, free tier. CONTACT_FROM must be a verified sender there.
RESEND_API_KEY=
CONTACT_FROM=

# Booking embed on /contact and the "Book a free 20-minute call" label: a Cal.com event link
# (with Google Meet as the location) or a Google Calendar appointment-schedule link.
NEXT_PUBLIC_CAL_LINK=

# Optional profile link for the footer.
NEXT_PUBLIC_LINKEDIN_URL=

# Stripe Payment Links, printed by: STRIPE_SECRET_KEY=... node scripts/stripe-setup.mjs
NEXT_PUBLIC_STRIPE_LINK_LAUNCH_SITE=
NEXT_PUBLIC_STRIPE_LINK_BUSINESS_ON_CLAUDE=
NEXT_PUBLIC_STRIPE_LINK_CARE=
NEXT_PUBLIC_STRIPE_LINK_DAY=
